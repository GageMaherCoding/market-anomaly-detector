{
  "id": null,
  "uid": "price-feed",
  "title": "Market — Live Price Feed",
  "tags": ["market-anomaly"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "ticker",
        "label": "Ticker",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "anomaly_pg" },
        "query": "SELECT DISTINCT ticker FROM public.price_snapshots ORDER BY 1",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Snapshots (range)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "anomaly_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "anomaly_pg" },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM public.price_snapshots WHERE $__timeFilter(captured_at)"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tickers tracked",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "anomaly_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "anomaly_pg" },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(DISTINCT ticker) AS value FROM public.price_snapshots WHERE $__timeFilter(captured_at)"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Price over time",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "anomaly_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "anomaly_pg" },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT captured_at AS \"time\", ticker AS metric, price AS value FROM public.price_snapshots WHERE $__timeFilter(captured_at) AND ticker IN ($ticker) ORDER BY captured_at"
        }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" }, "unit": "currencyUSD" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest price per ticker",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "anomaly_pg" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "anomaly_pg" },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (ticker) ticker, asset_type, price, captured_at FROM public.price_snapshots ORDER BY ticker, captured_at DESC"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    }
  ]
}
